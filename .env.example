# -----------------------------------------------------------------------------
# Oniric — variables de entorno
#
# Copia este archivo a `.env.local` y completa los valores:
#   cp .env.example .env.local
#
# `.env.local` está en .gitignore. Nunca subas secretos al repositorio.
# Las variables que empiezan con NEXT_PUBLIC_ se exponen al navegador: no pongas
# secretos en ellas.
#
# Para desarrollo local, `pnpm supabase:start` levanta Supabase en Docker e
# imprime los valores; los de ejemplo de abajo son los que usa la CLI por
# defecto en local (no son secretos).
# -----------------------------------------------------------------------------

# --- Aplicación ---------------------------------------------------------------

# URL pública de la app, sin barra final. Se usa en los enlaces de los correos
# de Supabase y en la vuelta del login con Google. Debe estar en la lista de
# "Redirect URLs" de Supabase (Authentication → URL Configuration).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ------------------------------------------------------------------

# Project Settings → API Keys (en local: `pnpm exec supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable (sb_publishable_...). Es pública por diseño: las tablas de
# Oniric tienen RLS sin políticas y solo se acceden desde el servidor.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Clave secreta (sb_secret_...). Solo en el servidor: da acceso total al
# proyecto. La app la usa para guardar y leer las fotos de producto en el bucket
# privado de Storage, y los tests e2e para crear usuarios de prueba. En local,
# cópiala de `pnpm exec supabase status` (SECRET_KEY). Nunca la expongas con el
# prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Muestra el botón "Continuar con Google". Actívalo solo después de configurar
# el proveedor Google en Supabase (Authentication → Sign In / Providers). En
# local, ver [auth.external.google] en supabase/config.toml.
AUTH_GOOGLE_ENABLED=false

# --- Base de datos (PostgreSQL de Supabase, usada por Drizzle) -----------------

# Conexión que usa la aplicación en tiempo de ejecución (db/index.ts).
# En Supabase: Project Settings → Database → Connection string → "Transaction
# pooler" (puerto 6543). El cliente desactiva los prepared statements porque
# este modo no los soporta.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Opcional. Conexión para `pnpm db:studio` y para aplicar migraciones en un
# proyecto remoto (ver docs/base-de-datos.md). Usa la "Direct connection" o el
# "Session pooler" (puerto 5432). Si se deja vacía, se usa DATABASE_URL.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL_DIRECT=

# --- Generación de videos e imágenes ------------------------------------------

# Sin clave se usa MockProvider (CLAUDE.md §8: nunca gastar saldo real en
# desarrollo ni en tests). El proveedor real de Higgsfield llega en la fase 3;
# mientras tanto, definir esta variable hace fallar las generaciones a propósito.
HIGGSFIELD_API_KEY=

# Milisegundos que el MockProvider tarda en "generar" (por defecto 5000).
MOCK_PROVIDER_LATENCY_MS=5000

# Secreto de la tarea programada GET /api/cron/generation (polling de jobs y
# vencimiento de créditos). El programador debe enviar
# `Authorization: Bearer <CRON_SECRET>`. Genera uno con `openssl rand -hex 32`.
CRON_SECRET=

# --- Pagos (Payphone) ----------------------------------------------------------

# Botón de pago de Payphone (docs/pagos.md). Solo en el servidor. En Payphone
# Developer: el token está en tu aplicación → Credenciales, y el StoreId en
# Solicitud de compañía → acciones de la solicitud aprobada.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# `mock` simula los pagos sin Payphone (se aprueban solos): para desarrollo y
# tests. Se ignora en la producción de Vercel. Sin esta variable ni Payphone,
# las compras en línea quedan desactivadas.
PAYMENT_GATEWAY=mock

# --- Solo tests e2e ------------------------------------------------------------

# Mailpit, para leer los correos de confirmación en los tests.
MAILPIT_URL=http://127.0.0.1:54324

# -----------------------------------------------------------------------------
# Las fotos de producto usan Supabase Storage con SUPABASE_SECRET_KEY.
# -----------------------------------------------------------------------------
